# 複製成 .env 後填入實際值（.env 不會進版控）

# CA 顯示名稱，會出現在根憑證與中繼憑證的 CN
CA_NAME=Example ZTNA

# 裝置連到 Step-CA 時使用的主機名稱
CA_DNS=ca.example.com

# SCEP 佈建器名稱，會出現在網址：/scep/<名稱>
SCEP_PROVISIONER=intune

# ── 模式二選一（在執行 init 之前決定，之後要改需重建 CA 或手動改 ca.json）──

# A. Webhook 模式（接 Intune / Entra）：填一個長隨機字串，例如 openssl rand -hex 24
#    啟動時加上 --profile webhook
WEBHOOK_TOKEN=

# B. 靜態挑戰密碼模式（僅限測試）：WEBHOOK_TOKEN 留空，改填這個
SCEP_CHALLENGE=

# ── 以下僅 Webhook 模式需要 ──

# intune：呼叫 Intune 驗證動態挑戰碼（正式）；static：比對 STATIC_CHALLENGE（測試）
CHALLENGE_MODE=intune
STATIC_CHALLENGE=

# 具備所需權限的 Entra 應用程式（見 phase3_webhook/README.md）
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# 群組的 vlan 目錄延伸屬性名稱，格式：extension_<appId 去連字號>_vlan
VLAN_ATTR=
